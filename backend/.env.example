# provider:model, e.g. anthropic:..., google_genai:..., openai:...
VISION_MODEL=
TEXT_MODEL=
LLM_API_KEY=
# Optional speed knobs
# LLM_KWARGS={"thinking_budget": 0}   # provider-specific extras passed to the model, e.g. less Gemini "thinking"

# Auth: long random string, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# OTP email. Leave SMTP_HOST empty in dev and the code is printed in the backend log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
